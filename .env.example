# Copy to .env (repo root) to enable the live model. Without a key, Viva runs in labelled mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Force mock mode even when a key is set (e.g. on unreliable venue Wi-Fi).
VIVA_MOCK=0
# Seconds before a model call gives up and the authored fallback is used.
VIVA_LLM_TIMEOUT=8

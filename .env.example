# Copy to .env in the repo root (it is gitignored). Without a key, Viva serves the example lab's prewritten quiz,
# and visitors can paste their own Anthropic key in the app to generate quizzes for their own materials.
ANTHROPIC_API_KEY=
VIVA_MODEL=claude-sonnet-5-5
VIVA_EFFORT=medium
VIVA_TIMEOUT=180
# Set to 1 to ignore all keys and use demo mode (e.g. unreliable Wi-Fi).
VIVA_DEMO=0
# Encrypts each quiz's answer key. REQUIRED in production (any long random string); keep it secret.
VIVA_SECRET=
